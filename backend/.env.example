# La API de IA solo se ejecuta en el servidor local.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_MESSAGE_LIMIT=6
LLM_MAX_OUTPUT_TOKENS=1200
LLM_CONTEXT_CHARS=16000
OLLAMA_URL=http://127.0.0.1:11434
# CONFIGURAR_SERVIDOR.cmd crea una clave de enlace aleatoria.
EXTENSION_ACCESS_TOKEN=
